# ScreenParty TURN 配置(复制为 .env;推荐直接运行 `party init` 交互生成)
# 改完执行 `party restart` 生效。

# 公网 IP(必填)。国内云服务器别用 ipify 之类自动探测,控制台里看
TURN_PUBLIC_IP=

# 主内网 IP(云服务器网卡只有内网 IP、公网走 NAT 时必填,如腾讯云/阿里云)
# 查看:ip route get 1.1.1.1 | grep -oP 'src \K\S+'
TURN_PRIVATE_IP=

# 与 Worker 的 COTURN_SECRET 必须一致。生成:openssl rand -hex 32
TURN_SECRET=

# 监听端口(与 Worker 的 COTURN_PORT 一致,默认 3478)
TURN_PORT=3478

# 中继端口段:每对中继连接两端各占一个;开「强制中继」时 8 人满房约需 56 个
TURN_MIN_PORT=49160
TURN_MAX_PORT=49400

# ---- 可选:TLS(turns://,穿透只放行加密流量的网络) ----
# 证书目录,需含 fullchain.pem 和 privkey.pem。宝塔示例:
#   /www/server/panel/vhost/cert/turn.你的域名
# 留空 = 不开 TLS。开启后在 Worker 配 COTURN_TLS_HOST=该域名
TURN_CERT_DIR=
TURN_TLS_PORT=5349

# ---- 可选:镜像地址 ----
# Docker Hub 在国内常拉不动,可改成镜像加速地址或你自己的腾讯云 TCR 仓库,例如:
#   TURN_IMAGE=docker.m.daocloud.io/coturn/coturn:4.6.3
TURN_IMAGE=coturn/coturn:4.6.3
