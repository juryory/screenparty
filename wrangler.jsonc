{
  "name": "screenparty",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // 部署时保留在 dashboard 里手动添加的变量(Secret 本来就会保留;这条让"文本"类型变量也不被清掉)
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "party.juryory.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      // 单例账号/会话存储(idFromName("global")):用户表 + 会话表
      { "name": "AUTH", "class_name": "Auth" },
      // 单例服务器结构(idFromName("global")):分类 / 频道 / 成员角色
      { "name": "GUILD", "class_name": "Guild" }
    ]
  },
  // 限流(Workers Rate Limiting,按边缘节点近似计数,免费计划可用):
  //   AUTH_LIMITER   登录 / 频道密码尝试:每 key 每分钟 10 次
  //   SIGNUP_LIMITER 注册 / 游客进入:每 IP 每分钟 5 次
  // 在 Worker 入口就拦掉,不让刷接口的请求打到单例 Auth DO 上跑 PBKDF2
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGNUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "migrations": [
    // SQLite-backed DO:Workers 免费计划即可使用
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Guild"] }
  ]
  // 鉴权:首次访问时用下列 secret 自动创建管理员账号(不进代码库)
  //   wrangler secret put ADMIN_USERNAME
  //   wrangler secret put ADMIN_PASSWORD
  //   wrangler secret put ADMIN_NICKNAME   // 可选,缺省用用户名
  //   wrangler secret put GUILD_NAME       // 可选,服务器显示名(ADMIN_USERNAME 即所有者)
  // 本地开发把它们写进 .dev.vars(已被 .gitignore 忽略)
  //
  // 必配:Cloudflare Realtime SFU(dashboard → Realtime → SFU 创建应用)
  //   wrangler secret put REALTIME_APP_ID
  //   wrangler secret put REALTIME_APP_SECRET
  //
  // 可选:接入 Cloudflare Realtime TURN,给连不上 SFU(屏蔽 UDP)的网络兜底
  // 在 dashboard 创建 TURN key 后执行:
  //   wrangler secret put TURN_KEY_ID
  //   wrangler secret put TURN_KEY_API_TOKEN
}
